#include sp_define.ini

[SYSTEM]
ShapeDir = S:\midage\shape_src
SoundDir = sound
SpriteDir = S:\midage\shape
BgPath = 
BgColor = 0x0
DelayUnit = 60
UseDefault = 2
UseDefine = 2
MinSize = 131072
MaxSize = 104857600
Mirror = 1


[DEFINE]
#define SP_NUMBER_MAX				0x7fffffff

#define SP_EVENT_ACT_WAIT                       0x00000001	//SP_EVENT_ACT_WAIT

#define SERV_CLASS_PLAYEROBJ                    0x80000102	//伺服器玩家物件
#define SP_CLASS_BASE                           0x00000001	//SP_CLASS_BASE
