#define SP_CLASS_MAPOBJ_PLANT                   0x00010002	//天然植物
#define SP_CLASS_MAPOBJ_CRUDE                   0x00020002	//天然雜物
#define SP_CLASS_MAPOBJ_ARTIFICIAL              0x00030002	//人工雜物
#define SP_CLASS_MAPOBJ_WALL                    0x00040002	//牆壁邊條
#define SP_CLASS_MAPOBJ_DYNAMICAL               0x00050002	//動態物件

#define SP_ATTRIB_DISTURB                       0x00020000	//SP_ATTRIB_DISTURB
